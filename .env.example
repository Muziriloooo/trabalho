# Desenvolvimento local; mantenha este arquivo sem credenciais.
SENTINELA_ENV=development
# SQLite fica em instance/sentinela.db quando DATABASE_URL não é definido.
# DATABASE_URL=sqlite:///sentinela.db
# Uma chave aleatória local é gerada em instance/dev-secret automaticamente.
# Em produção, SECRET_KEY forte e DATABASE_URL são obrigatórios.
# SECRET_KEY=
