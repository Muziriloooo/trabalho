# Desenvolvimento local; mantenha este arquivo sem credenciais.
SENTINELA_ENV=development
# SQLite fica em instance/sentinela.db quando DATABASE_URL não é definido.
# DATABASE_URL=sqlite:///sentinela.db
# Uma chave aleatória local é gerada em instance/dev-secret automaticamente.
# Em produção, SECRET_KEY forte e DATABASE_URL são obrigatórios.
# SECRET_KEY=
# Opcional: somente para câmeras reais via MediaMTX HTTPS.
# MEDIA_GATEWAY_HLS_URL=https://media.empresa.example
# MEDIA_GATEWAY_API_URL=https://media-api.empresa.example
# MEDIA_GATEWAY_ALLOWED_HOSTS=media.empresa.example,media-api.empresa.example
# MEDIA_GATEWAY_ALLOWED_PORTS=443
# CAMERA_ENCRYPTION_KEY=  # Chave Fernet real, não preencher neste arquivo de exemplo.
# Credenciais da câmera ficam exclusivamente no gateway.
